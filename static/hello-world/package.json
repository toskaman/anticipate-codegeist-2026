{
  "name": "global-full-page-custom-ui-static",
  "title": "Global full page custom UI static",
  "description": "Template for Global full page for custom UI static",
  "link": "https://developer.atlassian.com/platform/forge/manifest-reference/modules/confluence-full-page/",
  "version": "0.2.24-next.13",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@anticipate/contracts": "file:../../packages/contracts",
    "@forge/bridge": "7.2.1-next.13",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build && playwright test",
    "format": "prettier --write src tests benchmarks scripts *.ts *.js index.html package.json",
    "format:check": "prettier --check src tests benchmarks scripts *.ts *.js index.html package.json",
    "lint": "eslint src/**/*.ts src/**/*.tsx tests/**/*.ts benchmarks/**/*.ts",
    "preview": "vite preview",
    "benchmark:graph": "vitest run benchmarks/graph.test.ts",
    "licenses:inventory": "node scripts/license-inventory.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "overrides": {
    "prosemirror-view": "1.42.9",
    "prosemirror-model": "1.25.12"
  }
}
